<Window x:Class="WpfPaint.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WpfPaint.ViewModels"
        xmlns:models="clr-namespace:WpfPaint.Models"
        xmlns:converters="clr-namespace:WpfPaint.Views.Converters"
        xmlns:behaviors="clr-namespace:WpfPaint.Views.Behaviors"
        mc:Ignorable="d"
        Title="WPF Paint" Height="600" Width="800">
    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:PointToDoubleConverter x:Key="PointToDoubleConverter"/>
        <converters:ColorToStringConverter x:Key="ColorToStringConverter"/>
        <converters:PointCollectionConverter x:Key="PointCollectionConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Pencil" Command="{Binding SelectToolCommand}" CommandParameter="Pencil"/>
            <Button Content="Line" Command="{Binding SelectToolCommand}" CommandParameter="Line"/>
            <Button Content="Rectangle" Command="{Binding SelectToolCommand}" CommandParameter="Rectangle"/>
            <Button Content="Ellipse" Command="{Binding SelectToolCommand}" CommandParameter="Ellipse"/>
            <Separator/>
            <Button Content="Save" Command="{Binding SaveCommand}"/>
            <Button Content="Open" Command="{Binding OpenCommand}"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}"/>
            <Button Content="Redo" Command="{Binding RedoCommand}"/>
            <Separator/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Foreground:" VerticalAlignment="Center" Margin="5"/>
                <Rectangle Width="20" Height="20" Fill="{Binding ForegroundColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Black" StrokeThickness="1"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Background:" VerticalAlignment="Center" Margin="5"/>
                <Rectangle Width="20" Height="20" Fill="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Black" StrokeThickness="1"/>
            </StackPanel>
            <Separator/>
            <ToggleButton Content="Foreground" IsChecked="{Binding IsForegroundColorSelected, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="20" Height="20" Fill="Black">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectColorCommand}" CommandParameter="{Binding Fill, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorToStringConverter}}"/>
                    </Rectangle.InputBindings>
                </Rectangle>
                <Rectangle Width="20" Height="20" Fill="Red">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectColorCommand}" CommandParameter="{Binding Fill, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorToStringConverter}}"/>
                    </Rectangle.InputBindings>
                </Rectangle>
                <Rectangle Width="20" Height="20" Fill="Green">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectColorCommand}" CommandParameter="{Binding Fill, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorToStringConverter}}"/>
                    </Rectangle.InputBindings>
                </Rectangle>
                <Rectangle Width="20" Height="20" Fill="Blue">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectColorCommand}" CommandParameter="{Binding Fill, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorToStringConverter}}"/>
                    </Rectangle.InputBindings>
                </Rectangle>
            </StackPanel>
        </ToolBar>

        <!-- Canvas -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="5">
            <ItemsControl ItemsSource="{Binding Shapes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent"
                                behaviors:CanvasMouseBehavior.MouseDownCommand="{Binding MouseDownCommand}"
                                behaviors:CanvasMouseBehavior.MouseMoveCommand="{Binding MouseMoveCommand}"
                                behaviors:CanvasMouseBehavior.MouseUpCommand="{Binding MouseUpCommand}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type models:LineShape}">
                        <Line X1="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=X}" Y1="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=Y}" X2="{Binding EndPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=X}" Y2="{Binding EndPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=Y}" Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:RectangleShape}">
                        <Rectangle Canvas.Left="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=X}" Canvas.Top="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:EllipseShape}">
                        <Ellipse Canvas.Left="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=X}" Canvas.Top="{Binding StartPoint, Converter={StaticResource PointToDoubleConverter}, ConverterParameter=Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:PolylineShape}">
                        <Polyline Points="{Binding Points, Converter={StaticResource PointCollectionConverter}}" Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}"/>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTool, StringFormat='Tool: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
